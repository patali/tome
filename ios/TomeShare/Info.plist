<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Build-time configuration, injected from Config.xcconfig. The Share
	     Extension can't read the container app's UserDefaults without an App
	     Group (paid membership), so these baked-in values are the only
	     configuration it ever sees. -->
	<key>TOMEServerURL</key>
	<string>$(TOME_SERVER_URL)</string>
	<key>TOMEAPIKey</key>
	<string>$(TOME_API_KEY)</string>

	<!-- Required in full because GENERATE_INFOPLIST_FILE is NO. Without
	     CFBundleIdentifier here the built .appex carries no identifier, and the
	     build fails with "Embedded binary's bundle identifier is not prefixed
	     with the parent app's bundle identifier" — which reads like a naming
	     mistake but is actually a missing key. -->
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<!-- What the share sheet actually shows next to the icon. -->
	<key>CFBundleDisplayName</key>
	<string>Tome</string>
	<key>CFBundlePackageType</key>
	<string>XPC!</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<key>NSExtension</key>
	<dict>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.share-services</string>
		<key>NSExtensionPrincipalClass</key>
		<string>$(PRODUCT_MODULE_NAME).ShareViewController</string>

		<!-- The file iOS runs inside the live page. Named without the .js
		     extension, per Apple. Generated by
		     ios/Scripts/build-extraction-js.sh from the extension's own
		     extractors, so the app and the extension never disagree about how a
		     page is read. -->
		<key>NSExtensionJavaScriptPreprocessingFile</key>
		<string>TomeExtraction</string>

		<key>NSExtensionAttributes</key>
		<dict>
			<!-- Web pages only, exactly one. This is what makes Safari run our
			     preprocessing JavaScript; without it we'd receive a bare URL and
			     lose the logged-in DOM that makes Tome worth using. -->
			<key>NSExtensionActivationRule</key>
			<dict>
				<!-- Web pages: Safari. This is the one that makes iOS run our
				     preprocessing JavaScript inside the live page, which is how
				     logged-in articles extract without anyone signing in again. -->
				<key>NSExtensionActivationSupportsWebPageWithMaxCount</key>
				<integer>1</integer>
				<!-- Bare URLs: every other app (X, Reddit, Messages, Notes).
				     Without this Tome simply doesn't appear in their share
				     sheets. No DOM comes with these, so ShareViewController
				     hands them to the in-app browser instead. -->
				<key>NSExtensionActivationSupportsWebURLWithMaxCount</key>
				<integer>1</integer>
			</dict>
		</dict>
	</dict>
</dict>
</plist>
